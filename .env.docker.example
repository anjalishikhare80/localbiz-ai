# Copy to .env.docker and fill in. Used by docker-compose.yml
SECRET_KEY=change-me-to-a-long-random-string
DB_NAME=localbiz_db
DB_USER=localbiz_user
DB_PASSWORD=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Plain-http local trial only. REMOVE this line (or set True) on a real HTTPS server:
USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000
